import matplotlib.pyplot as plt
import numpy as np

#9.1


x = np.linspace(0,10,1000)
y = np.sin(x)
plt.plot(x,y,'r-',linestyle="solid", label = "sin(x)")
z = np.cos(x)
plt.plot(x,z,'g--',linestyle="dashed", label="cos(x)")
w = np.exp(-x)
plt.plot(x,w,'b:',linestyle="dotted", label="exp(-x)")
plt.legend()
plt.show()

